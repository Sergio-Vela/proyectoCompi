                                                                                                                                                                                              ;
                                                                                                                                                                                              
column ::= ID type
        {: RESULT = $1; :}
                ;
                
type ::= INT
       | DATETIME
              | VARCHAR LPAREN NUMBER RPAREN
                     | DECIMAL LPAREN NUMBER COMMA NUMBER RPAREN
                            ;
                            
values_list ::= values_list COMMA value
              {: 
                                        $1.add($3);
                                                          RESULT = $1;
                                                                        :}
                                                                                      | value
                                                                                                    {: 
                                                                                                                              List<String> values = new ArrayList<>();
                                                                                                                                                values.add($1);
                                                                                                                                                                  RESULT = values;
                                                                                                                                                                                :}
                                                                                                                                                                                              ;
                                                                                                                                                                                              
value ::= NUMBER
        {: RESULT = $1.toString(); :}
                | STRING
                        {: 
                                            String text = $1.toString();
                                                        RESULT = text.length() >= 2 ? text.substring(1, text.length() - 1) : text;
                                                                :}
                                                                        ;
                                                                        