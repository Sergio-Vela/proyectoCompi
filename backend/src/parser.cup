condition ::= field EQUALS field
            {: RESULT = new FileDatabase.Condition($1, $3, true); :}
                        | field EQUALS value
                                    {: RESULT = new FileDatabase.Condition($1, $3, false); :}
                                                ;
                                                
table_ref ::= table_ref JOIN table_factor ON LPAREN condition RPAREN
            {: throw new RuntimeException("JOIN no soportado"); :}
                        | table_factor
                                    {: RESULT = $1; :}
                                                ;
                                                
table_factor ::= ID
               {: RESULT = $1; :}
                              | ID ID
                                             {: RESULT = $1; :}
                                                            | ID AS ID
                                                                           {: RESULT = $1; :}
                                                                                          ;
                                                                                          
